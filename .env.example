# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./database.sqlite

# Security
JWT_SECRET=your-secret-key-change-this-in-production-make-it-long-and-random
JWT_EXPIRES=7d

# CORS
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,https://thecareereditbyepoch.netlify.app

# Email Configuration (optional - for sending notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=The Career Edit <noreply@thecareeredit.com>